{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File kho Chợ Nổi v1.2 (gather -> quan): kho cá thể có độ tươi",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "fresh"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ca_loc",
              "ca_linh",
              "ca_keo",
              "bong_dien_dien",
              "bong_sung",
              "keo_neo"
            ]
          },
          "fresh": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
